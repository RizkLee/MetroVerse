<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="./exoplayer" />
        <exclude
            domain="file"
            path="./download" />
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
        <exclude
            domain="file"
            path="datastore/settings.preferences_pb" />
        <exclude
            domain="sharedpref"
            path="secure_settings.xml" />
        <exclude
            domain="sharedpref"
            path="discord_token.xml" />
        <exclude
            domain="root"
            path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="./exoplayer" />
        <exclude
            domain="file"
            path="./download" />
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
        <exclude
            domain="file"
            path="datastore/settings.preferences_pb" />
        <exclude
            domain="sharedpref"
            path="secure_settings.xml" />
        <exclude
            domain="sharedpref"
            path="discord_token.xml" />
        <exclude
            domain="root"
            path="app_webview" />
    </device-transfer>
</data-extraction-rules>